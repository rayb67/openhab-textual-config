// Steuerung der Rollos/Raffstore in Abhaengigkeit von Winkel (Azimut), 
// Temperatur, Lichtstaerke und Hoehe (Elevation).
// Die Lichtstaerke wird ueber eine extra Rule ermittelt. Ziel ist es,
// dass erst nach 20 Minuten Sonnenschein, die Rollos herunter fahren.
// Wenn also bei einem Regentag, mal kurz ( kleiner 20 Minuten) die
// Sonne da ist, soll nicht sofort alles runter fahren. Dann hatte man
// ggf. am fruehen Morgen alles dunkeler im Haus.

var Number SunProElevation = 2|°		// Ab wann solls denn losgehen

//  Sollwert fuer Winkel Einfall und Ausfall der jeweiligen Hausseite
// Einstellbarkeit ueber GUI ueberfluessig
var Number SunProAzimutzOstEin  = 12|°	// 12   hard codiert
var Number SunProAzimutzOstAus  = 135|°	// 135  hard codiert
var Number SunProLichtOst  = 1000		// 1100 hard codiert SollWert Lichtstaerke

rule "Sun-Protechtion-Ost"
when
	Item astro_Azimuth changed
//	or Item oh_SunPro_TestSwitch changed 
then
    logDebug("sun-protecton-ost","##################################################################################")
    if (WetterLichtOAvg.state == NULL || WetterLichtOAvg.state == UNDEF) {
        logWarn("sun-protecton-ost", "WetterLichtOAvg ist nicht verfügbar: " + WetterLichtOAvg.state)
        return
    }
	
	val sunpro_ost =
		"\r\nOst  Licht : "+SunProLichtOst+ " < "+WetterLichtOAvg.state.format("%.0f")+" (avg) Winkel : " +SunProAzimutzOstEin+"  > "+astro_Azimuth.state.format("%.0f")+" < "+SunProAzimutzOstAus+"  Activ : "+oh_SunPro_control_Ost.state.toString+" Status : "+oh_SunPro_Status_Ost.state
	
	val sunpro_all =
		"\r\nTemp Aussen Ist : "+TempAussen.state+" > Soll    : "+oh_SunPro_SollTemp_Aussen.state+
		"\r\nTemp Aussen A3D : "+TempAussenAvg3D.state+" > Soll 3D : "+oh_SunPro_SollTemp_3DAussen.state+
		"\r\nTemp Wohnzimmer : "+lcn_Temp_EG_WohnzSofa.state.format("%.0f")+" > Soll    : "+oh_SunPro_SollTemp_Wohnz.state.format("%.0f")+
		"\r\nWinkel E     : "+astro_Elevation.state+" > "+SunProElevation

	logDebug("sun-protecton-ost",sunpro_all)
	logDebug("sun-protecton-ost",sunpro_ost)

	if  (oh_SunPro_Status_LevelHit.state == ON)
	{
		
		// ----------------------------------------------------------------------------------
		// ------ OST OST OST               ----------------------------------------------
		// ----------------------------------------------------------------------------------
	
		logDebug("sun-protecton-ost","Ost 1")
		logDebug("sun-protecton-ost",sunpro_ost)
		if(
			(SunProLichtOst < WetterLichtOAvg.state) &&
			(astro_Azimuth.state < SunProAzimutzOstAus) && // Sonne geht weg
			(astro_Azimuth.state > SunProAzimutzOstEin) &&     // Sonne kommt um die Ecke
			(oh_SunPro_control_Ost.state != OFF)
			)
		{
			logDebug("sun-protecton-ost","Ost ein : "+oh_SunPro_Status_Ost.state)
			if (oh_SunPro_Status_Ost.state != ON )
			{
				val actions = getActions("lcn","lcn:module:bus:S000M155")		// OST  ab  M155 C 1 HIT
				actions.hitKey("C", 1, "HIT")
				postUpdate(oh_SunPro_Status_Ost, "ON")
				logInfo("sun-protecton-ost","Ost-ein")
				logInfo("sun-protecton-ost",sunpro_all)
				logInfo("sun-protecton-ost",sunpro_ost)
				// Wenn Ost runter geht, dann sollte auch Sued runter fahren.
				// Auch wenn Sued Lichtstaerke noch nicht so hoch ist!
			    createTimer(now.plusSeconds(30)) [
					val actions = getActions("lcn","lcn:module:bus:S000M155")	// Ost  ab  M155 C 3 HIT (+Sued)
					actions.hitKey("C", 3, "HIT")
					postUpdate(oh_SunPro_Status_Sued, "ON")
					postUpdate(oh_SunPro_Status_Ost, "ON")
					logInfo("sun-protecton-ost","Ost-ein ... auch Sued")
			    ]
			}
		}
		else
		{
			if ( (oh_SunPro_Status_Ost.state == ON ) &&
			     (astro_Azimuth.state > SunProAzimutzOstAus) )        // Sonne geht weg
			{
				val actions = getActions("lcn","lcn:module:bus:S000M155")		// Ost  auf M155 C 2 HIT
				actions.hitKey("C", 2, "HIT")
				postUpdate(oh_SunPro_Status_Ost, "OFF")
				logInfo("sun-protecton-ost","Ost-aus 2")
			}
		}
	}
end
