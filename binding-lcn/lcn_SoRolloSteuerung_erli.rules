// Steuerung der Rollos/Raffstore in Abhaengigkeit von Winkel (Azimut), 
// Temperatur, Lichtstaerke und Hoehe (Elevation).
// Die Lichtstaerke wird ueber eine extra Rule ermittelt. Ziel ist es,
// dass erst nach 20 Minuten Sonnenschein, die Rollos herunter fahren.
// Wenn also bei einem Regentag, mal kurz ( kleiner 20 Minuten) die
// Sonne da ist, soll nicht sofort alles runter fahren. Dann hatte man
// ggf. am fruehen Morgen alles dunkeler im Haus.

var Number SunProElevation = 2|°		// Ab wann solls denn losgehen

//  Sollwert fuer Winkel Einfall und Ausfall der jeweiligen Hausseite
// Einstellbarkeit ueber GUI ueberfluessig

var Number SunProAzimutzErLiEin = 180|°	// 180  hard codiert
var Number SunProAzimutzErLiAus = 330|°	// 330  hard codiert
var Number SunProLichtErLi = 1005		// 1075 hard codiert SollWert Lichtstaerke

rule "Sun-Protechtion-erli"
when
	Item astro_Azimuth changed
	or Item oh_SunPro_TestSwitch changed 
then
    logDebug("sun-protecton-erli","##################################################################################")
    if (WetterLichtWAvg.state == NULL || WetterLichtWAvg.state == UNDEF) {
        logInfo("sun-protecton-erli", "WetterLichtWAvg ist nicht verfügbar: " + WetterLichtWAvg.state)
        return
    }

	
	val sunpro_erli =
		"\r\nErLi Licht : "+SunProLichtErLi+" < "+WetterLichtWAvg.state.format("%.0f")+" (avg) Winkel : "+SunProAzimutzErLiEin+" > "+astro_Azimuth.state.format("%.0f")+" < "+SunProAzimutzErLiAus +"  State : "+oh_SunPro_control_ErLi.state.toString+" Status : "+oh_SunPro_Status_ErLi.state

	val sunpro_all =
		"\r\nTemp Aussen Ist : "+TempAussen.state+" > Soll    : "+oh_SunPro_SollTemp_Aussen.state+
		"\r\nTemp Aussen A3D : "+TempAussenAvg3D.state+" > Soll 3D : "+oh_SunPro_SollTemp_3DAussen.state+
		"\r\nTemp Wohnzimmer : "+lcn_Temp_EG_WohnzSofa.state.format("%.0f")+" > Soll    : "+oh_SunPro_SollTemp_Wohnz.state.format("%.0f")+
		"\r\nWinkel E     : "+astro_Elevation.state+" > "+SunProElevation

	logDebug("sun-protecton-erli",sunpro_all)
	logDebug("sun-protecton-erli",sunpro_erli)

	if  (oh_SunPro_Status_LevelHit.state == ON)
	{
	
		// ----------------------------------------------------------------------------------
		// ------ ErLi ErLi ErLi               ----------------------------------------------
		// ----------------------------------------------------------------------------------
	
		logDebug("sun-protecton-erli","ErLi 1-x")
		logDebug("sun-protecton-erli",sunpro_erli)
	
		if( 
			(SunProLichtErLi < WetterLichtWAvg.state) &&
			(astro_Elevation.state > SunProElevation) &&
			(astro_Azimuth.state < SunProAzimutzErLiAus) && // Sonne geht weg
			(astro_Azimuth.state > SunProAzimutzErLiEin) &&     // Sonne kommt um die Ecke
			(oh_SunPro_control_ErLi.state != OFF)
			)
		{
			logDebug("sun-protecton-erli","ErLi-ein moeglich")
			if (oh_SunPro_Status_ErLi.state != ON )
			{
				val actions = getActions("lcn","lcn:module:bus:S000M160")		// ErLi ab  M160 A 5 HIT 
				actions.hitKey("A", 5, "HIT")
				postUpdate(oh_SunPro_Status_ErLi, "ON")
				postUpdate( oh_SunPro_Status_KuecheAbendsHoch , "OFF")          // Reset
				logInfo("sun-protecton-erli","ErLi-ein DOWN")
				logInfo("sun-protecton-erli",sunpro_all)
				logInfo("sun-protecton-erli",sunpro_erli)
			}
		}
		else
		{
			if ( (oh_SunPro_Status_ErLi.state==ON ) &&
				(astro_Azimuth.state > SunProAzimutzErLiAus) && 
				(astro_Elevation.state < SunProElevation) ) 
			{
	      		if (oh_SunPro_BlockAbendsHoch.state != ON)
	      			{
					val actions = getActions("lcn","lcn:module:bus:S000M160")	// ErLi auf M160 A 6 HIT
					actions.hitKey("A", 6, "HIT")
					logInfo("sun-protecton-erli","ErLi-aus UP")
				}
				postUpdate(oh_SunPro_Status_ErLi, "OFF")
			}
		}
	
	}
end
