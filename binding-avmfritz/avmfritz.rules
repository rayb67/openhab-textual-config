// Idee geklaut aus :
// https://community.openhab.org/t/oh3-rule-for-tr064-binding-does-not-work/139293/12
rule "FritzBoxInbound"
when
    Item Fritz_CallState changed to RINGING 
then
    val incCall = Fritz_IncomingCall.state as StringListType
    val ourNumber = incCall.getValue(0)
    val callerNumber = incCall.getValue(1)
    val tr064Actions = getActions("tr064","tr064:fritzbox:10.10.10.1")
    val callerName = tr064Actions.phonebookLookup(callerNumber,5)

    logDebug("FritzBoxInbound","ourNumber    : "+ourNumber)
    logDebug("FritzBoxInbound","callerNumber : "+callerNumber)
    logDebug("FritzBoxInbound","callerName   : "+callerName)

    Fritz_LastInboundCall.postUpdate(callerName)
    Fritz_LastInboundNumber.postUpdate(callerNumber)
    Fritz_LastInboundLine.postUpdate(ourNumber)

    var String msg = "Inbound : Der Anruf von" + " '" + Fritz_LastInboundCall.state +"' " + " Telefon-Nr. " 
		+ Fritz_LastInboundNumber.state + " erfolgte an die eigene Nr. " + Fritz_LastInboundLine.state + " ."

    logInfo("FritzBoxInbound", msg)
	   //actions.sendMessage(msg, "openHAB")

	logDebug("FritzBoxInbound", "play sound")
//   	playSound("squeezebox:squeezeboxplayer:badsrv:mobile", "doorbell.mp3")
//   	playSound("squeezebox:squeezeboxplayer:badsrv:mobile", "original-iphone-ring.mp3")
//	playSound("squeezebox:squeezeboxplayer:badsrv:wohnzimmer", "doorbell.mp3")
//	playSound("squeezebox:squeezeboxplayer:badsrv:kueche", "doorbell.mp3")
//	playSound("squeezebox:squeezeboxplayer:badsrv:buero", "doorbell.mp3")
//	playSound("squeezebox:squeezeboxplayer:badsrv:kueche", "original-iphone-ring.mp3")
	// Das ist die Voice Funtion. Die muss noch als binding rein
//	say("Achtung das Telefon klingelt", "voicerss:deDE", "squeezebox:squeezeboxplayer:badsrv:mobile", new PercentType(60))

	logDebug("FritzBoxInbound", "...ende")

end

rule "FritzBoxOutbound"
when
    Item Fritz_CallState changed to DIALING 
then

    val outCall = Fritz_OutgoingCall.state as StringListType
    var String calledNumber = outCall.getValue(0)
    var String ourNumber = outCall.getValue(1)
    val tr064Actions = getActions("tr064","tr064:fritzbox:10.10.10.1")
    val calleeName = tr064Actions.phonebookLookup(calledNumber,5) 

    Fritz_LastOutboundCall.postUpdate(calleeName)
    Fritz_LastOutboundNumber.postUpdate(calledNumber)
    Fritz_LastOutboundLine.postUpdate(ourNumber)

    var String msg = "Outbound : Der Anruf an" + " '" + Fritz_LastOutboundCall.state +"' " + " Telefon-Nr. " 
		+ Fritz_LastOutboundNumber.state + " erfolgte über die eigene Nr. " + Fritz_LastOutboundLine.state + " ."
    logInfo("FritzBoxOutbound", msg)
	   //actions.sendMessage(msg, "openHAB")
end

