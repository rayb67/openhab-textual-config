sitemap avmfritz label="AVM Fritz" {

    Frame label="FRITZ!Box Status" {
        Text item=Fritz_CallState
        Text item=Fritz_IncomingCall
        Text item=Fritz_ActiveCall
        Text item=Fritz_OutgoingCall
    }
    Frame label="Outbound / Ausgehend" {
        Text item=Fritz_LastOutboundCall
        Text item=Fritz_LastOutboundNumber
        Text item=Fritz_LastOutboundLine
    }
    Frame label="Inbound / Eingehend" {
        Text item=Fritz_LastInboundCall
        Text item=Fritz_LastInboundNumber
        Text item=Fritz_LastInboundLine
    }
}
