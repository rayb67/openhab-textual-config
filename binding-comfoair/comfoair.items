Group				gComfoAir							"Lueftungsanalge"						<selfinfo>		(EG_Technik)	[Equipment]

//##############################################################################
//##############################################################################
// Damit wird nachts im Hochsommer das Dachfenster und die Lueftungsstaerke gesteuert.
// Damit soll zusätzlich die Temperatur im Haus gesenkt werden
Switch				comfoair_control_auto				"Belueftung auto On/Off"		<settings>		(gComfoAir)		[Control]
Switch				comfoair_control_noon				"Tagesüber Control On/Off"		<settings>		(gComfoAir)     [Control] 
Switch				comfoair_state_night				"Belueftung (Status Night)"		<info>			(gComfoAir)		[Status,Mode]
Switch				comfoair_state_day					"Belueftung (Status Day)"		<info>			(gComfoAir)		[Status,Mode]
Switch				comfoair_state_heiss				"Belueftung (Status) heiss"		<info>			(gComfoAir)		[Status,Mode]


Switch				comfoair_control					"Steuerung [%s]"				<switch>	(gComfoAir)	[Control]	
{channel="comfoair:comfoair:myComfoAir:bindingControl#activate"}
Number				comfoair_FanLevel					"Ventilation level"				<chart>		(gComfoAir) [Control]	
{channel="comfoair:comfoair:myComfoAir:ventilation#fanLevel"}
Number				comfoair_ErrorReset					"Error reset"					<service>	(gComfoAir) [State]
{channel="comfoair:comfoair:myComfoAir:resets#errorReset"}
Number				comfoair_FilterReset				"Filter reset"					<service>	(gComfoAir) [State]
{channel="comfoair:comfoair:myComfoAir:resets#filterReset"}
Switch				comfoair_FilterError				"Filter Error"					<service>	(gComfoAir)	[State]
{channel="comfoair:comfoair:myComfoAir:errors#filterError"}
Number				comfoair_FilterPeriod				"Filter period [%d weeks]"		<clock>		(gComfoAir) [State]
{channel="comfoair:comfoair:myComfoAir:menuP2#filterWeeks"}

// Messages
String				comfoair_Error						"Error: [%s]"					<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:errors#errorsCurrent"}
String				comfoair_ErrorLast					"Error Last: [%s]"				<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:errors#errorsLast"}
String				comfoair_ErrorPrelast				"ErrorPrelast: [%s]"			<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:errors#errorsPrelast"}
Number:Time			comfoair_FilterRuntime				"Filter runtime [%.0f h]"		<time>			(gComfoAir)	[Duration, Status]
{channel="comfoair:comfoair:myComfoAir:times#filterHours", unit="s" }


// Bypass
Switch				comfoair_BypassSummer				"Bypass Summer Mode"			<switch>		(gComfoAir)
{channel="comfoair:comfoair:myComfoAir:bypass#bypassSummer"}
Number				comfoair_BypassFactor				"Bypass Factor"					<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:bypass#bypassFactor"}
Number				comfoair_BypassLevel				"Bypass Level"					<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:bypass#bypassLevel"}
Number				comfoair_BypassCorrection			"Bypass Correction"				<info>			(gComfoAir)	[Property]
{channel="comfoair:comfoair:myComfoAir:bypass#bypassCorrection"}

Number:Time			comfoair_BypassTime					"Bypass Time (h) [%d h]"		<time>			(gComfoAir)	[Duration, Status]	
{channel="comfoair:comfoair:myComfoAir:times#bypassTime"}
Number:Time			comfoair_FreezeTime					"Frostschutz Time (h) [%d h]"		<time>			(gComfoAir)	[Duration, Status]	
{channel="comfoair:comfoair:myComfoAir:times#freezeTime"}

Switch				comfoair_BypassMode				"Bypass [MAP(comfoair_on-off.map):%s]"	<info>			(gComfoAir)	[Switch]
{channel="comfoair:comfoair:myComfoAir:menuP9#bypassState"}

Number				comfoair_OptionsBypass			"Option Bypass [MAP(comfoair_on-off.map):%s]"	<info>	(gComfoAir)	[Measuremet]
{channel="comfoair:comfoair:myComfoAir:options#isBypass"}
Number				comfoair_OptionsCookerhood		"Option Cookerhood [MAP(comfoair_on-off.map):%s]"	<info>	(gComfoAir)	[Measuremet]
{channel="comfoair:comfoair:myComfoAir:options#isCookerhood"}

// State
Number:Temperature	comfoair_TargetTemperature			"Comfort temperature [%.1f °C]"		<temperature>	(gComfoAir)	[Temperature]
{channel="comfoair:comfoair:myComfoAir:temperatures#targetTemperature"}
