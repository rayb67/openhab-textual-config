// Because i use an extra thing file for the broker definition, the next line 
// is only for information. Put hat in an extra file, if you have more than one mqtt sources.
// Bridge mqtt:broker:mybroker "MQTT -1- Broker" [ host="10.10.10.68", port=1883, keepAlive=66, secure=false, qos=1 ]

Thing mqtt:topic:watermeter "MQTT ESP32-CAM Water Meter" (mqtt:broker:mybroker) {
	Channels:
		Type number : value			[ stateTopic="watermeter/main/value" ,
			transformationPattern="REGEX:^0*(\\d+)\\.0$" ]
		Type string : error			[ stateTopic="watermeter/main/error"]
		Type number : CPUtemp		[ stateTopic="watermeter/CPUtemp"]
		Type number : freeMem		[ stateTopic="watermeter/freeMem"]
		Type string : status		[ stateTopic="watermeter/status"]
		Type string : connection	[ stateTopic="watermeter/connection"]
		Type string : fwVersion		[ stateTopic="watermeter/fwVersion"]
}
